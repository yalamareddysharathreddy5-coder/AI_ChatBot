# Groq API key. Create one at https://console.groq.com/keys
# Used server-side by api/chat.js. Never commit the real key.
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the default model
# GROQ_MODEL=openai/gpt-oss-20b

# Optional: OpenWeatherMap API key (free at https://openweathermap.org/api).
# If set, weather uses OpenWeatherMap. If unset, Open-Meteo (no key) is used.
# Never commit the real key.
# WEATHER_API_KEY=your_openweathermap_api_key_here