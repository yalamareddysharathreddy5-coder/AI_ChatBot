# Groq Cloud (recommended)
GROQ_API_KEY=your_groq_key_here
# Current Groq models - update from https://console.groq.com/docs/models
GROQ_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# Google Gemini (optional fallback)
AI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Unsplash (optional - if not set, falls back to Wikimedia Commons)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
