# Groq Cloud (required for AI chat, speech-to-text, and cloud voices)
GROQ_API_KEY=your_groq_key_here
# Current Groq models - update from https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_WHISPER_MODEL=whisper-large-v3

# Google Gemini (optional fallback for chat)
AI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Unsplash (optional - if not set, image search falls back to Wikimedia Commons)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
